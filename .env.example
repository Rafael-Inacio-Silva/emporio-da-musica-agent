# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Optional. Fixes "today" (ISO format, e.g. 2026-03-25) so the agent can work
# with orders and promotions from another period. Empty means the current date
# in America/Campo_Grande.
REFERENCE_DATE=
